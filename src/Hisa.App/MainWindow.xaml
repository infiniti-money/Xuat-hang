<Window x:Class="Hisa.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý kho" Icon="/Assets/hisa.ico" Width="1480" Height="940" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#132D40">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,22,20,18"><Border Width="72" Height="72" Background="White" CornerRadius="12" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14"><Image Source="/Assets/hisa-logo.jpg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Hisa Elevator"/></Border><TextBlock Text="Quản lý kho" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="KIỆN HÀNG / HƯNG YÊN" Foreground="#62C1BD" FontSize="10" FontWeight="SemiBold" Margin="2,5,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="24,18"><Border Background="#203F52" CornerRadius="7" Padding="12"><StackPanel><TextBlock x:Name="VersionText" Text="Phiên bản 1.2.1" Foreground="#C4D9E5" FontSize="12"/><TextBlock Text="Dữ liệu lưu tại máy" Foreground="#7E9DB0" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E1E8EE" BorderThickness="0,0,0,1" Padding="28,0">
        <DockPanel VerticalAlignment="Center"><Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="↻  Cập nhật dữ liệu" Margin="15,0,0,0" Click="RefreshClick"/><StackPanel><TextBlock x:Name="PageTitle" Text="Tổng quan kho" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Hợp đồng, kiện hàng và tiến độ xuất kho" Foreground="#70869B" Margin="0,4,0,0" FontSize="12"/></StackPanel></DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="26,20" x:Name="PageHost"/>
      <Border Grid.Row="2" Background="White" BorderBrush="#E1E8EE" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel VerticalAlignment="Center"><TextBlock DockPanel.Dock="Right" x:Name="LoadTimeText" Foreground="#70869B" FontSize="11"/><TextBlock x:Name="StatusText" Text="Đang khởi tạo…" Foreground="#54758A" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
